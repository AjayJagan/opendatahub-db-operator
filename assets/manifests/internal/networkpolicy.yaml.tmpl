apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: {{.Service.Name}}
  namespace: {{.Namespace}}
  labels:
    app.kubernetes.io/name: {{.Service.Name}}
    app.kubernetes.io/component: databaseprovider
    db.infrastructure.opendatahub.io/provider: {{.ProviderName}}
spec:
  podSelector:
    matchLabels:
      app.kubernetes.io/name: {{.Service.Name}}
  policyTypes:
    - Ingress
{{- if or .Network.OperatorNamespace (gt (len .Network.AllowedNamespaces) 0) }}
  ingress:
    # Internal PostgreSQL has no port override; keep this aligned with its Service and container.
    - ports:
        - port: 5432
          protocol: TCP
      from:
{{- if .Network.OperatorNamespace }}
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: {{ .Network.OperatorNamespace }}
          podSelector:
            matchLabels:
              app.kubernetes.io/name: opendatahub-db-operator
{{- end }}
{{- if gt (len .Network.AllowedNamespaces) 0 }}
        - namespaceSelector:
            matchExpressions:
              - key: kubernetes.io/metadata.name
                operator: In
                values:
{{- range .Network.AllowedNamespaces }}
                  - {{ . }}
{{- end }}
{{- end }}
{{- else }}
  ingress: []
{{- end }}
